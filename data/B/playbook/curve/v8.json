 "cause": {
  "type": "interview",
  "correction_id": "B-COR-0007",
  "rule_id": "B-R-009",
  "note": "Yes, sweep interest goes to 7100 Interest income. Our policy doesn't name a staff accountant role, so if it's anything other than straightforward sweep interest, send it to me.",
  "explanation": "The controller confirmed that sweep interest goes to 7100 Interest income. They also said there is no staff accountant role, and anything other than straightforward sweep interest should go to them. B-R-009 is modified to drop the staff accountant wording and then approved. A new rule, B-R-009a, goes after it and before B-R-010, so other interest credits reach the controller instead of the AR lead catch-all in B-R-016. B-R-009a is non-executable because 'not straightforward sweep interest' can't be fully checked. If the non-sweep interest credits also say INTEREST CREDIT, B-R-009 will still book them to 7100. Knowing how the sweep line is worded, or a normal amount range, would let B-R-009 be narrowed.",
  "patch": {
   "kind": "ops",
   "ops": [
    {
     "op": "modify",
     "rule_id": "B-R-009",
     "executable": true,
     "text": "Straightforward interest credited on the sweep account is booked to 7100 Interest income.",
     "when": {
      "item_kind": "bank",
      "direction": "in",
      "description_regex": "INTEREST CREDIT"
     },
     "then": {
      "action": "book",
      "account": "7100"
     }
    },
    {
     "op": "approve",
     "rule_id": "B-R-009"
    },
    {
     "op": "add",
     "rule_id": "B-R-009a",
     "insert_before": "B-R-010",
     "executable": false,
     "text": "An incoming bank credit described as interest that is not straightforward interest on the sweep account goes to the controller before anything is booked.",
     "when": {
      "item_kind": "bank",
      "direction": "in",
      "description_regex": "INTEREST"
     },
     "then": {
      "action": "escalate",
      "escalate_to": "controller"
     },
     "assigned_id": "B-R-019"
    }
   ],
   "origin": "interview B-COR-0007"
  }
 }
}