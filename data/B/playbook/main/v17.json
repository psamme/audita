 "cause": {
  "type": "correction",
  "correction_id": "B-COR-0019",
  "item_id": "B-BL-00501",
  "note": "Varnholt pays via Ledgerlane portal, which keeps 1.25% (600.00). per MSA sched C and controller's standing approval (3/27): match, fee to 6310. not a short-pay, no escalation",
  "explanation": "Your correction contradicts B-R-024, which sent 1.25% short Varnholt receipts to the AR lead. Under MSA Schedule C and the controller's standing approval of 3/27, the 1.25% Ledgerlane portal fee is not a short-pay. I rewrote B-R-024 to match the receipt to the open Varnholt invoice in 1200 and book the 1.25% to 6310 payment processing fees. The rule only applies when the bank line mentions Ledgerlane and the shortfall is exactly 1.25%. Other Varnholt shortfalls still go through the general short-payment rules. The rules can check every condition, so it runs automatically.",
  "check": "B-R-024 now reproduces the human's resolution on this item",
  "by_role": null,
  "patch": {
   "kind": "ops",
   "ops": [
    {
     "op": "modify",
     "rule_id": "B-R-024",
     "executable": true,
     "text": "A Varnholt Biosciences receipt paid through the Ledgerlane portal that is 1.25% short of its 1200 accounts receivable invoice is matched to the invoice and the 1.25% portal fee is booked to 6310 payment processing fees, not treated as a short-pay.",
     "when": {
      "direction": "in",
      "counterparty_regex": "varnholt",
      "description_regex": "ledgerlane",
      "candidate": {
       "by": "counterparty",
       "account": "1200",
       "window_days": 10
      },
      "diff_min": 0.01,
      "diff_pct_min": 1.249,
      "diff_pct_max": 1.251
     },
     "then": {
      "action": "match_adjust",
      "account": "6310"
     }
    }
   ],
   "origin": "correction B-COR-0019"
  }
 }
